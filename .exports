export EDITOR='subl -w'
export VISUAL='subl -w'
export ZSH="$HOME/.oh-my-zsh"
export GOPATH="${GOPATH:-$HOME/go}"
export PNPM_HOME="$HOME/Library/pnpm"
export BUN_INSTALL="$HOME/.bun"
path=("/Applications/Sublime Text.app/Contents/SharedSupport/bin" "$HOME/bin" $path "$HOME/.local/bin" "$GOPATH/bin" "$PNPM_HOME" "$BUN_INSTALL/bin")
unset CODEX_MANAGED_BY_NPM CODEX_MANAGED_PACKAGE_ROOT
